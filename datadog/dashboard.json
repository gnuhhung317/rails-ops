{
  "title": "CompressorGuard — Metro APU Fleet Operations, AI/ML & Incident Command",
  "description": "Unified Operational, Physics & AI/ML Observability Control Plane for RailOps VN Metro Line 1 Fleet APU-COMP-01 (MUGVN Hackathon 2026)",
  "layout_type": "ordered",
  "widgets": [
    {
      "id": 1,
      "definition": {
        "title": "Discharge Valve Pressure (DV_pressure) vs Loaded Baseline",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:compressorguard.telemetry.dv_pressure_bar{asset_id:APU-COMP-01} by {regime}",
            "display_type": "line",
            "style": {
              "palette": "warm",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "markers": [
          {
            "value": "y = 2.0",
            "display_type": "error dashed",
            "label": "Critical Leak Threshold (2.0 bar)"
          },
          {
            "value": "y = -0.016",
            "display_type": "ok solid",
            "label": "Healthy Loaded Baseline (-0.016 bar)"
          }
        ]
      }
    },
    {
      "id": 2,
      "definition": {
        "title": "Compressor Oil Temperature (°C) vs Thermal Stress Ceiling",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:compressorguard.telemetry.oil_temp_c{asset_id:APU-COMP-01}",
            "display_type": "line",
            "style": {
              "palette": "cool",
              "line_type": "solid",
              "line_width": "normal"
            }
          }
        ],
        "markers": [
          {
            "value": "y = 74.0",
            "display_type": "error dashed",
            "label": "Severe Thermal Drift (74°C)"
          },
          {
            "value": "y = 67.0",
            "display_type": "warning dashed",
            "label": "Commissioning Ceiling (67°C)"
          }
        ]
      }
    },
    {
      "id": 3,
      "definition": {
        "title": "Main Brake Reservoir Pressure (TP3/H1) & Legacy LPS Switch",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:compressorguard.telemetry.tp3_bar{asset_id:APU-COMP-01}",
            "display_type": "line",
            "style": {
              "palette": "dog_classic",
              "line_type": "solid",
              "line_width": "normal"
            }
          },
          {
            "q": "max:compressorguard.telemetry.lps_active{asset_id:APU-COMP-01}",
            "display_type": "bars",
            "style": {
              "palette": "orange"
            }
          }
        ],
        "markers": [
          {
            "value": "y = 7.5",
            "display_type": "warning dashed",
            "label": "Safe Depot Routing Floor (7.5 bar)"
          },
          {
            "value": "y = 7.0",
            "display_type": "error solid",
            "label": "Mechanical LPS Trip (7.0 bar)"
          }
        ]
      }
    },
    {
      "id": 4,
      "definition": {
        "title": "AI/ML Observability: Multivariate Isolation Forest Score & Physics Consensus",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:compressorguard.ml.anomaly_score{asset_id:APU-COMP-01}",
            "display_type": "bars"
          },
          {
            "q": "avg:compressorguard.ml.physics_agreement{asset_id:APU-COMP-01}",
            "display_type": "line"
          }
        ],
        "markers": [
          {
            "value": "y = 0.35",
            "display_type": "warning dashed",
            "label": "ML Corroboration Threshold (0.35)"
          }
        ]
      }
    },
    {
      "id": 5,
      "definition": {
        "title": "Alert Fatigue Protection: Suppressed Transient Spikes vs. Active Case Transitions",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:compressorguard.signals.suppressed_total{asset_id:APU-COMP-01}.as_count()",
            "display_type": "bars"
          },
          {
            "q": "sum:compressorguard.case.transitions_total{asset_id:APU-COMP-01}.as_count()",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "id": 6,
      "definition": {
        "title": "Post-Maintenance Commissioning Streak (5/5 Healthy LOADED Cycles)",
        "type": "query_value",
        "requests": [
          {
            "q": "max:compressorguard.recovery.consecutive_observations{asset_id:APU-COMP-01}"
          }
        ],
        "autoscale": true,
        "custom_unit": "cycles",
        "precision": 0
      }
    },
    {
      "id": 7,
      "definition": {
        "title": "APM Distributed Trace & ML Inference Latency (ms)",
        "type": "timeseries",
        "requests": [
          {
            "q": "avg:trace.compressorguard.detector.evaluate.duration{env:hackathon-2026} by {resource_name}",
            "display_type": "line"
          },
          {
            "q": "avg:compressorguard.ml.inference_latency_ms{asset_id:APU-COMP-01}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "id": 8,
      "definition": {
        "title": "Historical Counterfactual Early Warning Benchmark (Hours)",
        "type": "query_value",
        "requests": [
          {
            "q": "max:compressorguard.incident.lead_time_seconds{asset_id:APU-COMP-01} / 3600"
          }
        ],
        "autoscale": true,
        "custom_unit": "hours",
        "precision": 1
      }
    }
  ]
}
