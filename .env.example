# ==============================================================================
# RailOps VN — CompressorGuard Environment Configuration (.env.example)
# MUGVN Hackathon 2026: MongoDB + Datadog · Team Flex
# Copy this template to .env and configure with your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Datadog Observability Control Plane (APM Tracing + DogStatsD Metrics)
# ------------------------------------------------------------------------------
# Your Datadog API Key (mandatory for live Datadog streaming)
DD_API_KEY=your_datadog_api_key_here

# Datadog Site / Intake Region (ap2.datadoghq.com for MUGVN Singapore region)
DD_SITE=ap2.datadoghq.com

# Environment tag attached to all metrics, traces, and monitors
DD_ENV=hackathon-2026

# Datadog Agent Host (use "localhost" for local agent, "agent" inside docker-compose)
DD_AGENT_HOST=localhost

# DogStatsD UDP port
DD_DOGSTATSD_PORT=8125

# Datadog APM trace receiver TCP port
DD_TRACE_AGENT_PORT=8126

# Toggle ddtrace APM instrumentation (true/false)
DD_TRACE_ENABLED=true

# Datadog global tags
DD_TAGS=team:railops solution:compressorguard

# ------------------------------------------------------------------------------
# 2. MongoDB Multi-Modal Storage (Time Series + Document Collections)
# ------------------------------------------------------------------------------
# Connection string: Standalone local mongod or MongoDB Atlas cluster
# Local mongod: mongodb://localhost:27017
# Atlas cluster: mongodb+srv://<username>:<password>@cluster0.xxxxxxx.mongodb.net/
MONGODB_URI=mongodb://localhost:27017

# Database name for Time Series telemetry, anomalies, incidents, and audit ledger
MONGODB_DB_NAME=compressorguard

# ------------------------------------------------------------------------------
# 3. Edge IoT Telemetry Bus (Decoupled MQTT Producer)
# ------------------------------------------------------------------------------
# MQTT Broker connection URL
# Local Mosquitto: tcp://localhost:1883
# Docker container: tcp://mosquitto:1883
MQTT_BROKER=tcp://localhost:1883

# ------------------------------------------------------------------------------
# 4. Web Command Console Server Settings
# ------------------------------------------------------------------------------
# Bind host and port for FastAPI application
HOST=127.0.0.1
PORT=8000

# Optional: Override path to custom MetroPT-3 CSV dataset
# Defaults automatically to dataset/MetroPT3(AirCompressor).csv or dataset/MetroPT3-demo-slice.csv
# TELEMETRY_CSV=dataset/MetroPT3-demo-slice.csv
